local folder=Instance.new("Folder")
folder.Name="GeneratedMap"
folder.Parent=workspace

local created={}

for _,p in ipairs(data) do

	local part

	if p.ClassName=="SpawnLocation" then

		part=Instance.new("SpawnLocation")

	elseif p.ClassName=="WedgePart"
	or p.ClassName=="CornerWedgePart" then

		part=Instance.new(p.ClassName)

	else

		part=Instance.new("Part")
	end

	-- Remove stud/inlet surfaces

	part.TopSurface=Enum.SurfaceType.Smooth
	part.BottomSurface=Enum.SurfaceType.Smooth
	part.LeftSurface=Enum.SurfaceType.Smooth
	part.RightSurface=Enum.SurfaceType.Smooth
	part.FrontSurface=Enum.SurfaceType.Smooth
	part.BackSurface=Enum.SurfaceType.Smooth

	part.Anchored=true
	part.CanCollide=p.CanCollide
	part.CanTouch=p.CanTouch
	part.CanQuery=p.CanQuery

	part.Name=p.Name
	part.Size=p.Size
	part.CFrame=p.CFrame
	part.Color=p.Color
	part.Material=p.Material
	part.Transparency=p.Transparency
	part.Reflectance=p.Reflectance

	part.AssemblyLinearVelocity=Vector3.zero
	part.AssemblyAngularVelocity=Vector3.zero

	if p.Decals then

		for _,d in ipairs(p.Decals) do

			local decal=Instance.new("Decal")

			decal.Name=d.Name
			decal.Texture=d.Texture
			decal.Face=d.Face
			decal.Transparency=d.Transparency
			decal.Color3=d.Color3

			decal.Parent=part
		end
	end

	part.Parent=folder

	part.Anchored=true
	part.AssemblyLinearVelocity=Vector3.zero
	part.AssemblyAngularVelocity=Vector3.zero

	table.insert(created,part)
end

for _,part in ipairs(created) do

	if part and part.Parent then

		part.Anchored=true
		part.AssemblyLinearVelocity=Vector3.zero
		part.AssemblyAngularVelocity=Vector3.zero

	end
end

task.spawn(function()

	while folder.Parent do

		for _,part in ipairs(folder:GetDescendants()) do

			if part:IsA("BasePart") then

				if not part.Anchored then
					part.Anchored=true
				end

				part.AssemblyLinearVelocity=Vector3.zero
				part.AssemblyAngularVelocity=Vector3.zero

			end
		end

		task.wait(0.25)
	end
end)
