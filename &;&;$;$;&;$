local function clearMap()

	local character=player.Character

	for _,v in ipairs(workspace:GetChildren()) do

		if v~=character
		and not v:IsA("Terrain")
		and not v:IsA("Camera") then

			pcall(function()
				v:Destroy()
			end)

		end
	end
end

